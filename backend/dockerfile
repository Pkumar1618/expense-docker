FROM node:20.18.0-alpine3.20
EXPOSE 8080
ENV DB_HOST="mysql"
# RUN addgroup -S appgroup && adduser -S appuser -G appgroup
RUN addgroup -S expense && adduser -S expense -G expense
RUN mkdir /opt/server
RUN chown -R expense:expense /opt/server
WORKDIR /opt/server
COPY package.json .
COPY *.js .
RUN npm install 
USER expense
CMD ["node", "index.js"]

